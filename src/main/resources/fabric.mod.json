{
  "schemaVersion": 1,
  "id": "worldbinder",
  "version": "${version}",
  "name": "WorldBinder",
  "description": "WorldBinder 1.4.1 is a client-side Fabric tool for permitted world capture, visual HUD customization, chunk mapping, archive recovery, validation and target-version world export.",
  "authors": [
    "Philiipp06"
  ],
  "contact": {
    "homepage": "https://discord.com/invite/V7h3vaXxDZ",
    "sources": "https://github.com/Philiipp06/WorldBinder",
    "issues": "https://github.com/Philiipp06/WorldBinder/issues"
  },
  "license": "MIT",
  "icon": "assets/worldbinder/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.worldbinder.client.WorldBinderClient"
    ],
    "modmenu": [
      "net.worldbinder.integration.WorldBinderModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.160.7+26.3"
  },
  "suggests": {
    "modmenu": ">=21.0.0-beta.1"
  },
  "mixins": [
    "worldbinder.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "links": {
        "Website": "https://discord.com/invite/V7h3vaXxDZ",
        "Source": "https://github.com/Philiipp06/WorldBinder",
        "Issues": "https://github.com/Philiipp06/WorldBinder/issues"
      }
    }
  }
}
